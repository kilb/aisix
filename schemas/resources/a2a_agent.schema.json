{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "auth_type": {
            "const": "bearer"
          }
        },
        "required": [
          "auth_type"
        ]
      },
      "then": {
        "properties": {
          "secret": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "secret"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "auth_type": {
            "const": "api_key"
          }
        },
        "required": [
          "auth_type"
        ]
      },
      "then": {
        "properties": {
          "secret": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "secret"
        ]
      }
    }
  ],
  "anyOf": [
    {
      "required": [
        "name"
      ],
      "title": "name"
    },
    {
      "required": [
        "display_name"
      ],
      "title": "display_name"
    }
  ],
  "definitions": {
    "A2aAuthType": {
      "description": "How the gateway authenticates to an upstream A2A agent.",
      "oneOf": [
        {
          "description": "No authentication; the agent is reached as-is.",
          "enum": [
            "none"
          ],
          "title": "No authentication",
          "type": "string"
        },
        {
          "description": "Bearer token authentication. The token is supplied in `secret` and sent as `Authorization: Bearer <secret>`.",
          "enum": [
            "bearer"
          ],
          "title": "Bearer token",
          "type": "string"
        },
        {
          "description": "API key authentication. The key is supplied in `secret` and sent as an `x-api-key: <secret>` header on every upstream request.",
          "enum": [
            "api_key"
          ],
          "title": "API key",
          "type": "string"
        }
      ]
    },
    "A2aProtocolVersion": {
      "description": "The A2A wire-format version pinned for an upstream agent.",
      "oneOf": [
        {
          "description": "A2A 1.0 wire format with protobuf-JSON envelopes and PascalCase methods.",
          "enum": [
            "1.0"
          ],
          "title": "A2A 1.0",
          "type": "string"
        },
        {
          "description": "A2A 0.3 wire format with `kind`-discriminated JSON-RPC objects.",
          "enum": [
            "0.3"
          ],
          "title": "A2A 0.3",
          "type": "string"
        }
      ]
    }
  },
  "properties": {
    "auth_type": {
      "allOf": [
        {
          "$ref": "#/definitions/A2aAuthType"
        }
      ],
      "default": "none",
      "description": "How the gateway authenticates to the upstream agent. The credential is held by the gateway and is never forwarded from or exposed to the calling client."
    },
    "display_name": {
      "description": "Accepted as an alternative spelling of `name`. Provide the label under exactly one of the two names.",
      "minLength": 1,
      "pattern": "^[^/?#%\\s\\x00-\\x1f\\x7f-]+$",
      "type": "string"
    },
    "enabled": {
      "default": true,
      "description": "Whether this agent is active. When `false`, it is not served and cannot be reached.",
      "type": "boolean"
    },
    "name": {
      "description": "Operator-facing label, unique within the gateway. It is the path segment under which the agent is exposed to callers as `/a2a/<name>`, so it must be a single non-empty URL path segment. The name is interpolated into the advertised agent-card URL without percent-encoding, so `/`, `?`, `#`, `%` and whitespace are rejected: `a?b` would advertise a URL whose path is just `/a2a/a`, and the lookup is an exact match on the stored name.",
      "minLength": 1,
      "pattern": "^[^/?#%\\s\\x00-\\x1f\\x7f-]+$",
      "type": "string"
    },
    "protocol_version": {
      "allOf": [
        {
          "$ref": "#/definitions/A2aProtocolVersion"
        }
      ],
      "default": "1.0",
      "description": "The A2A wire-format version this agent speaks. AISIX announces it to the agent in the `A2A-Version` header on every request, so it must match what the agent actually serves: an agent reads an absent or mismatched version as a protocol error and rejects the call."
    },
    "secret": {
      "description": "Credential AISIX uses to authenticate to the upstream agent. For `bearer`, AISIX sends it as `Authorization: Bearer <secret>`; for `api_key`, AISIX sends it as `x-api-key: <secret>`. Leave unset for `none`.",
      "type": [
        "string",
        "null"
      ]
    },
    "timeout_ms": {
      "description": "Maximum time, in milliseconds, to wait for a single upstream operation, including fetching the agent card or invoking the agent. When omitted, AISIX applies a built-in default.",
      "format": "uint64",
      "minimum": 1.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "url": {
      "description": "The upstream agent's A2A service endpoint, such as `https://agents.example.com/a2a`, where AISIX sends JSON-RPC 2.0 requests over HTTP. The value must be an absolute HTTP or HTTPS URL with a host and must not embed credentials in user information or credential-like query parameters. AISIX looks for the agent card at the well-known path under this URL's own path first, then under its origin, so both an agent that owns its domain and one published under a path prefix are reachable without extra configuration.",
      "format": "uri",
      "minLength": 1,
      "not": {
        "pattern": "^[^?#]*\\?(?:[^#&]*&)*(?:(?:[Kk][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Yy]|[Ss][^A-Za-z0-9=&#]*[Ii][^A-Za-z0-9=&#]*[Gg]|[Jj][^A-Za-z0-9=&#]*[Ww][^A-Za-z0-9=&#]*[Tt]|[Aa][^A-Za-z0-9=&#]*[Uu][^A-Za-z0-9=&#]*[Tt][^A-Za-z0-9=&#]*[Hh]|[Aa][^A-Za-z0-9=&#]*[Uu][^A-Za-z0-9=&#]*[Tt][^A-Za-z0-9=&#]*[Hh][^A-Za-z0-9=&#]*[Oo][^A-Za-z0-9=&#]*[Rr][^A-Za-z0-9=&#]*[Ii][^A-Za-z0-9=&#]*[Zz][^A-Za-z0-9=&#]*[Aa][^A-Za-z0-9=&#]*[Tt][^A-Za-z0-9=&#]*[Ii][^A-Za-z0-9=&#]*[Oo][^A-Za-z0-9=&#]*[Nn]|[Aa][^A-Za-z0-9=&#]*[Pp][^A-Za-z0-9=&#]*[Ii][^A-Za-z0-9=&#]*[Kk][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Yy]|[Aa][^A-Za-z0-9=&#]*[Cc][^A-Za-z0-9=&#]*[Cc][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Ss][^A-Za-z0-9=&#]*[Ss][^A-Za-z0-9=&#]*[Kk][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Yy]|[Aa][^A-Za-z0-9=&#]*[Cc][^A-Za-z0-9=&#]*[Cc][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Ss][^A-Za-z0-9=&#]*[Ss][^A-Za-z0-9=&#]*[Tt][^A-Za-z0-9=&#]*[Oo][^A-Za-z0-9=&#]*[Kk][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Nn]|[Aa][^A-Za-z0-9=&#]*[Uu][^A-Za-z0-9=&#]*[Tt][^A-Za-z0-9=&#]*[Hh][^A-Za-z0-9=&#]*[Tt][^A-Za-z0-9=&#]*[Oo][^A-Za-z0-9=&#]*[Kk][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Nn]|[Rr][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Ff][^A-Za-z0-9=&#]*[Rr][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Ss][^A-Za-z0-9=&#]*[Hh][^A-Za-z0-9=&#]*[Tt][^A-Za-z0-9=&#]*[Oo][^A-Za-z0-9=&#]*[Kk][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Nn]|[Ii][^A-Za-z0-9=&#]*[Dd][^A-Za-z0-9=&#]*[Tt][^A-Za-z0-9=&#]*[Oo][^A-Za-z0-9=&#]*[Kk][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Nn]|[Cc][^A-Za-z0-9=&#]*[Ll][^A-Za-z0-9=&#]*[Ii][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Nn][^A-Za-z0-9=&#]*[Tt][^A-Za-z0-9=&#]*[Ss][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Cc][^A-Za-z0-9=&#]*[Rr][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Tt]|[Ss][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Cc][^A-Za-z0-9=&#]*[Rr][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Tt][^A-Za-z0-9=&#]*[Kk][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Yy]|[Pp][^A-Za-z0-9=&#]*[Rr][^A-Za-z0-9=&#]*[Ii][^A-Za-z0-9=&#]*[Vv][^A-Za-z0-9=&#]*[Aa][^A-Za-z0-9=&#]*[Tt][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Kk][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Yy]|[Ss][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Ss][^A-Za-z0-9=&#]*[Ss][^A-Za-z0-9=&#]*[Ii][^A-Za-z0-9=&#]*[Oo][^A-Za-z0-9=&#]*[Nn][^A-Za-z0-9=&#]*[Kk][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Yy]|[Ss][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Ss][^A-Za-z0-9=&#]*[Ss][^A-Za-z0-9=&#]*[Ii][^A-Za-z0-9=&#]*[Oo][^A-Za-z0-9=&#]*[Nn][^A-Za-z0-9=&#]*[Tt][^A-Za-z0-9=&#]*[Oo][^A-Za-z0-9=&#]*[Kk][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Nn]|[Ss][^A-Za-z0-9=&#]*[Uu][^A-Za-z0-9=&#]*[Bb][^A-Za-z0-9=&#]*[Ss][^A-Za-z0-9=&#]*[Cc][^A-Za-z0-9=&#]*[Rr][^A-Za-z0-9=&#]*[Ii][^A-Za-z0-9=&#]*[Pp][^A-Za-z0-9=&#]*[Tt][^A-Za-z0-9=&#]*[Ii][^A-Za-z0-9=&#]*[Oo][^A-Za-z0-9=&#]*[Nn][^A-Za-z0-9=&#]*[Kk][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Yy]|[Xx][^A-Za-z0-9=&#]*[Aa][^A-Za-z0-9=&#]*[Mm][^A-Za-z0-9=&#]*[Zz][^A-Za-z0-9=&#]*[Cc][^A-Za-z0-9=&#]*[Rr][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Dd][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Nn][^A-Za-z0-9=&#]*[Tt][^A-Za-z0-9=&#]*[Ii][^A-Za-z0-9=&#]*[Aa][^A-Za-z0-9=&#]*[Ll]|[Xx][^A-Za-z0-9=&#]*[Aa][^A-Za-z0-9=&#]*[Mm][^A-Za-z0-9=&#]*[Zz][^A-Za-z0-9=&#]*[Ss][^A-Za-z0-9=&#]*[Ii][^A-Za-z0-9=&#]*[Gg][^A-Za-z0-9=&#]*[Nn][^A-Za-z0-9=&#]*[Aa][^A-Za-z0-9=&#]*[Tt][^A-Za-z0-9=&#]*[Uu][^A-Za-z0-9=&#]*[Rr][^A-Za-z0-9=&#]*[Ee]|[Xx][^A-Za-z0-9=&#]*[Aa][^A-Za-z0-9=&#]*[Mm][^A-Za-z0-9=&#]*[Zz][^A-Za-z0-9=&#]*[Ss][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Cc][^A-Za-z0-9=&#]*[Uu][^A-Za-z0-9=&#]*[Rr][^A-Za-z0-9=&#]*[Ii][^A-Za-z0-9=&#]*[Tt][^A-Za-z0-9=&#]*[Yy][^A-Za-z0-9=&#]*[Tt][^A-Za-z0-9=&#]*[Oo][^A-Za-z0-9=&#]*[Kk][^A-Za-z0-9=&#]*[Ee][^A-Za-z0-9=&#]*[Nn])|(?:(?:[Kk][Ee][Yy]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Tt][Oo][Kk][Ee][Nn]|[Ss][Ii][Gg][Nn][Aa][Tt][Uu][Rr][Ee]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Aa][Pp][Ii][Kk][Ee][Yy])(?:[^A-Za-z0-9=&#][^=&#]*)?|[^=&#]*[^A-Za-z0-9=&#](?:[Kk][Ee][Yy]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Tt][Oo][Kk][Ee][Nn]|[Ss][Ii][Gg][Nn][Aa][Tt][Uu][Rr][Ee]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Aa][Pp][Ii][Kk][Ee][Yy])(?:[^A-Za-z0-9=&#][^=&#]*)?)|[^=&#]*%[0-9A-Fa-f]{2}[^=&#]*)(?:=|&|#|$)"
      },
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#@]+(?:[/?#]|$)",
      "type": "string"
    }
  },
  "required": [
    "url"
  ],
  "title": "A2aAgent",
  "type": "object"
}
