{
  "name": "aisix-cp-tenant-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:unit": "node --experimental-strip-types --test src/lib/*.test.ts",
    "e2e": "playwright test",
    "e2e:real": "playwright test --config=playwright.real.config.ts",
    "e2e:real:internal": "playwright test --config=playwright.internal-real.config.ts",
    "e2e:refined": "playwright test --config=playwright.refined-real.config.ts",
    "typecheck:refined": "tsc -p tsconfig.refined-real.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@tailwindcss/vite": "4.3.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.71.0",
    "radix-ui": "1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
